root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.sql]
indent_size = 2

[*.{cc,cpp,h}]
indent_size = 2

[*.{kt,kts,java}]
indent_size = 4
